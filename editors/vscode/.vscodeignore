src/**
tsconfig.json
**/*.ts
**/*.map
.vscode/**

# NOTE: node_modules is deliberately NOT excluded.
# `vscode-languageclient` is a runtime dependency; excluding node_modules
# produces a .vsix that fails on activation with
# "Cannot find module 'vscode-languageclient/node'".
# Trim dev-only packages instead:
node_modules/typescript/**
node_modules/@types/**
node_modules/@vscode/vsce/**
