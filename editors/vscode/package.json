{
  "name": "gale-lint",
  "displayName": "Gale CSS Linter",
  "description": "An extremely fast CSS linter, written in Rust",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "gale",
  "repository": {
    "type": "git",
    "url": "https://github.com/LyricalString/gale"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "css",
    "scss",
    "less",
    "sass",
    "linter"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:less",
    "onLanguage:sass"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Gale CSS Linter",
      "properties": {
        "gale.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the Gale CSS linter."
        },
        "gale.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to a Gale configuration file. If empty, Gale will auto-discover the config."
        },
        "gale.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the gale binary. If empty, Gale is looked up in node_modules/.bin, then on PATH."
        }
      }
    },
    "commands": [
      {
        "command": "gale.restart",
        "title": "Gale: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "typescript": "^5.7.0"
  }
}
