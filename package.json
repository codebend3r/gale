{
  "name": "@codebend3r/gale",
  "version": "0.2.0",
  "description": "An extremely fast CSS linter, written in Rust. Drop-in replacement for Stylelint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codebend3r/gale"
  },
  "homepage": "https://github.com/codebend3r/gale",
  "bugs": "https://github.com/codebend3r/gale/issues",
  "keywords": [
    "css",
    "linter",
    "stylelint",
    "scss",
    "less",
    "rust",
    "fast",
    "lint",
    "gale"
  ],
  "type": "module",
  "main": "npm/index.mjs",
  "exports": {
    ".": {
      "import": "./npm/index.mjs",
      "require": "./npm/index.cjs"
    }
  },
  "bin": {
    "gale": "npm/bin/gale"
  },
  "files": [
    "npm/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "bash scripts/build-npm.sh",
    "build:all": "bash scripts/build-npm.sh --all",
    "build:release": "cargo build --release",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "system-check": "run-s fmt:check lint build:release test",
    "test": "run-s test:rust test:api test:features",
    "test:api": "GALE_BINARY=target/release/gale node npm/test.mjs",
    "test:features": "bun test --parallel=8 tests/features",
    "test:rust": "cargo test --workspace"
  },
  "devDependencies": {
    "npm-run-all2": "9.0.3"
  }
}
