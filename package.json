{
  "name": "gale-workspace",
  "private": true,
  "description": "Development scripts for gale. The published package is npm/package.json.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/codebend3r/gale"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "warn"
    }
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bash scripts/build-npm.sh",
    "build:all": "bash scripts/build-npm.sh --all",
    "build:release": "cargo build --release",
    "benchmark": "bash benchmarks/benchmark.sh",
    "benchmark:quick": "bash benchmarks/benchmark-quick.sh",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "system-check": "bun run --sequential fmt:check lint build:release build test",
    "test": "bun run --sequential test:rust test:api test:features",
    "test:api": "GALE_BINARY=target/release/gale node npm/test.mjs",
    "test:features": "bun test --parallel=8 tests/features",
    "test:rust": "cargo test -q --workspace --lib --bins --tests"
  },
  "devDependencies": {
    "lefthook": "2.2.1"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
