{
  "name": "@codebend3r/gale",
  "version": "0.2.0",
  "description": "An extremely fast CSS linter, written in Rust. Drop-in replacement for Stylelint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LyricalString/gale"
  },
  "homepage": "https://github.com/LyricalString/gale",
  "bugs": "https://github.com/LyricalString/gale/issues",
  "keywords": [
    "css",
    "linter",
    "stylelint",
    "scss",
    "less",
    "rust",
    "fast",
    "lint",
    "gale"
  ],
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    }
  },
  "bin": {
    "gale": "bin/gale"
  },
  "files": [
    "bin/",
    "index.cjs",
    "index.mjs",
    "test.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "test": "node test.mjs"
  }
}
